# --- Sign-in (REQUIRED in production) ---------------------------------------
# The server refuses to start in production without these. In development, built-in
# demo passwords are used (and a warning is printed): admin / doctor / staff.
ADMIN_PASSWORD=
DOCTOR_PASSWORD=
STAFF_PASSWORD=

# Session cookie is "Secure" (HTTPS only) in production. Set to false ONLY for an
# internal plain-HTTP network; prefer terminating TLS in front of the app instead.
# COOKIE_SECURE=false

# Server port (default 3000)
# PORT=3000

# Extra browser origins (host[:port], comma separated) allowed to call the API when the
# site is served under a different name than the backend sees (e.g. behind a reverse proxy).
# ALLOWED_ORIGINS=intranet.example.go.th

# --- MySQL: procurement registry (purchase orders, contracts, guarantees, ...) ---
DB_HOST=192.168.1.241
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=dw_hp_procure

# --- MySQL: HOSxP (READ ONLY) - source of user accounts for user management ---
# Users are copied from tables opduser and doctor. Sign-in checks the password against HOSxP.
# Use an account that can only SELECT.
HOS_DB_HOST=192.168.1.253
HOS_DB_PORT=3306
HOS_DB_USER=
HOS_DB_PASSWORD=
HOS_DB_NAME=hos

# Encrypts the ThaID/Provider ID client secrets and Google Authenticator seeds stored in the database.
# Generate once (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") and never change it afterwards.
SECRETS_KEY=

# Behind a reverse proxy (nginx...): number of proxies in front, so audit logs and the device list show the real client address.
# Leave empty when users reach the app directly.
# TRUST_PROXY=1
